# Copy this file to .env and replace all placeholder credentials locally.
POSTGRES_DB=ai_lab
POSTGRES_USER=lab_user
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_PORT=5432

EMBEDDING_API_URL=https://quanzil.com/v1/embeddings
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=gemini-embedding-2-preview:stable
EMBEDDING_ROUTE=
EMBEDDING_DIMENSION=3072

CHAT_API_URL=https://quanzil.com/v1/chat/completions
CHAT_API_KEY=replace-with-your-chat-api-key
CHAT_MODEL=gemini-2.5-flash:stable
CHAT_ROUTE=

# approved: only veterinarian-reviewed knowledge (default)
# local_draft: local development only; also retrieves pending_vet_review records
RAG_KNOWLEDGE_MODE=approved
# Ignore weak vector matches before they reach the chat model.
RAG_MIN_SIMILARITY=0.68
